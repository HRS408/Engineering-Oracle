# ============================================================
# Engineering Oracle — Environment Variables
# ============================================================
# Copy this file to .env and fill in the values you need.
# Only API keys for services you intend to use are required.
# ============================================================

# --- Execution Environment ---
# Options: "local" | "api" | "hybrid"
# local  = HuggingFace embeddings + Ollama LLM (no API keys needed)
# api    = OpenAI embeddings + OpenAI LLM
# hybrid = HuggingFace embeddings + OpenAI LLM (mix and match)
RAG_ENVIRONMENT=local

# --- OpenAI (required for 'api' or 'hybrid' environment) ---
OPENAI_API_KEY=sk-your-openai-key-here

# --- Cohere (optional, for Cohere embeddings/reranking) ---
COHERE_API_KEY=your-cohere-key-here

# --- Nomic (optional, for Nomic embeddings) ---
NOMIC_API_KEY=your-nomic-key-here

# --- LlamaParse (optional, for advanced document parsing) ---
LLAMA_CLOUD_API_KEY=your-llamaparse-key-here

# --- Pinecone (optional, for managed vector store) ---
PINECONE_API_KEY=your-pinecone-key-here
PINECONE_ENVIRONMENT=your-pinecone-env

# --- Ollama Configuration (for 'local' environment) ---
# Default base URL, change if Ollama runs on a different host/port
OLLAMA_BASE_URL=http://localhost:11434

# --- Hardware ---
# Options: "cpu" | "cuda" | "mps"
DEVICE=cpu
